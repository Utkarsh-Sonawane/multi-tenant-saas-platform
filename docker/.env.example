# ============================================================
# .env.example — Copy to .env and fill in real values
# ============================================================

# ── Flask ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-hex-string
FLASK_DEBUG=false
PORT=5000
ENVIRONMENT=production

# ── Config DB (shared tenant registry) ────────────────────
CONFIG_DB_HOST=your-rds-endpoint.rds.amazonaws.com
CONFIG_DB_PORT=5432
CONFIG_DB_NAME=config_db
CONFIG_DB_USER=config_user
CONFIG_DB_PASSWORD=CHANGE_ME

# ── Tenant DB credentials (per namespace via K8s secret) ──
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=tenant_user
DB_PASSWORD=CHANGE_ME

# ── AWS ────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ── Kubernetes ─────────────────────────────────────────────
K8S_NAMESPACE=tenant-a
# HOSTNAME is auto-set to pod name in Kubernetes

# ── Gunicorn ───────────────────────────────────────────────
WORKERS=4
WORKER_CLASS=gthread
THREADS=2
TIMEOUT=120
