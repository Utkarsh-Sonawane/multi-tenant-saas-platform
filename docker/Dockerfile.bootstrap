FROM python:3.12-slim
WORKDIR /bootstrap
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY database/ /bootstrap/database/
RUN useradd --system --uid 1001 bootstrap && chown -R bootstrap:bootstrap /bootstrap
USER bootstrap
CMD ["python", "/bootstrap/database/bootstrap.py"]
